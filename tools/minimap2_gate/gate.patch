+/* Rustle patch (parallel chains): minimap2 aligns the chains of one query one after another, so one query with many
+ * chains (a long locus in a multi-copy region, all-vs-all) can hold a whole batch. Each chain owns its seeds (disjoint
+ * after mm_squeeze_a()); the remainders that mm_align1() splits off a chain, and an inversion between two of them, are
+ * inserted right after it and only ever look back within that run. So the run grown from each original chain is a
+ * task of its own: the tasks run on mm_align_threads threads, each with its own memory pool and DP buffer, and the runs
+ * are concatenated in chain order -- the array the sequential loop builds. mm_align1() reverses a stretch of the encoded
+ * query in place for the left extension and restores it, so every thread works on its own copy of the query. Set by
+ * --gate (the Rustle all-vs-all). */
+int mm_align_threads = 1;
+int64_t mm_align_par_min_span = 10000000; // summed chain span (bp) of a query aligned in parallel: ~10 s of DP or more
+
+typedef struct {
+	const mm_mapopt_t *opt;
+	const mm_idx_t *mi;
+	int qlen, n_a;
+	uint8_t *qbuf; // one copy of the encoded query (both strands, 2 x qlen) per thread
+	void **km;     // one memory pool per thread, reused by its tasks (as the sequential loop reuses one)
+	ksw_extz_t *ez; // one DP buffer per thread
+	mm128_t *a;
+	const mm_reg1_t *in;
+	mm_reg1_t **run;
+	int *n_run;
+} mm_align_par_t;
+
+static int mm_align_par_wanted(const mm_mapopt_t *opt, int n_regs, const mm_reg1_t *regs)
+{
+	int64_t span = 0;
+	int i;
+	if (mm_align_threads <= 1 || n_regs < 8 || (opt->flag & MM_F_SPLICE)) return 0;
+	for (i = 0; i < n_regs; ++i) span += regs[i].re - regs[i].rs;
+	return span >= mm_align_par_min_span; // a smaller query does not hold up a batch
+}
+
+static void mm_align_par_run(void *data, long k, int tid)
+{
+	mm_align_par_t *d = (mm_align_par_t*)data;
+	void *km = d->km[tid];
+	ksw_extz_t *ez = &d->ez[tid];
+	mm_reg1_t *run = (mm_reg1_t*)malloc(sizeof(mm_reg1_t));
+	int n = 1, i;
+	uint8_t *qseq0[2];
+	qseq0[0] = d->qbuf + (size_t)tid * 2 * d->qlen, qseq0[1] = qseq0[0] + d->qlen;
+	run[0] = d->in[k];
+	for (i = 0; i < n; ++i) { // the loop of mm_align_skeleton() over this run (an original chain never has split_inv)
+		mm_reg1_t r2;
+		mm_align1(km, d->opt, d->mi, d->qlen, qseq0, &run[i], &r2, d->n_a, d->a, ez, d->opt->flag);
+		if (r2.cnt > 0) run = mm_insert_reg(&r2, i, &n, run);
+		if (i > 0 && run[i].split_inv && !(d->opt->flag & MM_F_NO_INV)) {
+			if (mm_align1_inv(km, d->opt, d->mi, d->qlen, qseq0, &run[i-1], &run[i], &r2, ez)) {
+				run = mm_insert_reg(&r2, i, &n, run);
+				++i; // skip the inserted INV alignment
+			}
+		}
+	}
+	d->run[k] = run, d->n_run[k] = n;
+}
