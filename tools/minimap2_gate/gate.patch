diff --git a/dpmemo.c b/dpmemo.c
new file mode 100644
index 0000000..3b16fa4
--- /dev/null
+++ b/dpmemo.c
@@ -0,0 +1,136 @@
+/* Rustle patch (DP memo), see dpmemo.h. A chained hash table under one mutex; the whole table is dropped when it exceeds
+ * its byte cap (overlapping loci are adjacent in the input, so reuse is local). Keys are compared in full. */
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+#include <pthread.h>
+#include "dpmemo.h"
+
+typedef struct ent_s {
+	uint64_t h;
+	uint32_t key_len;
+	uint32_t *key;
+	mm_dpm_out_t out;
+	struct ent_s *next;
+} ent_t;
+
+#define NB (1u<<20)
+static ent_t **g_b = 0;
+static pthread_mutex_t g_lock = PTHREAD_MUTEX_INITIALIZER;
+static uint64_t g_cap = 0, g_bytes = 0, g_hits = 0, g_miss = 0, g_flush = 0, g_vbad = 0;
+static int g_verify = 0;
+
+int mm_dpm_active(void) { return g_b != 0; }
+
+void mm_dpm_init(uint64_t cap_bytes)
+{
+	g_b = (ent_t**)calloc(NB, sizeof(ent_t*));
+	g_cap = cap_bytes;
+	g_verify = getenv("MM_DPM_VERIFY") != 0;
+}
+
+static inline uint64_t mix(uint64_t a, uint64_t w, uint64_t m, int r)
+{
+	a = (a ^ w) * m;
+	return a << r | a >> (64 - r);
+}
+
+void mm_dpm_hash(const uint8_t *s, int64_t n, uint64_t h[2])
+{
+	uint64_t a = 0x243f6a8885a308d3ULL ^ (uint64_t)n, b = 0x13198a2e03707344ULL, w;
+	int64_t i = 0;
+	for (; i + 8 <= n; i += 8) {
+		memcpy(&w, s + i, 8);
+		a = mix(a, w, 0x9e3779b97f4a7c15ULL, 31);
+		b = mix(b, w << 23 | w >> 41, 0xc2b2ae3d27d4eb4fULL, 27);
+	}
+	w = 0;
+	if (i < n) memcpy(&w, s + i, n - i);
+	a = mix(a, w ^ 0xa5, 0x9e3779b97f4a7c15ULL, 31);
+	b = mix(b, w ^ 0x5a, 0xc2b2ae3d27d4eb4fULL, 27);
+	h[0] = a ^ (b >> 29), h[1] = b ^ (a >> 31);
+}
+
+static uint64_t key_hash(const uint32_t *k, uint32_t n)
+{
+	uint64_t h[2];
+	mm_dpm_hash((const uint8_t*)k, (int64_t)n * 4, h);
+	return h[0];
+}
+
+static mm_extra_t *copy_p(const mm_extra_t *p)
+{
+	mm_extra_t *q;
+	if (p == 0) return 0;
+	q = (mm_extra_t*)malloc(p->capacity * 4);
+	memcpy(q, p, (sizeof(mm_extra_t) / 4 + p->n_cigar) * 4);
+	q->capacity = p->capacity;
+	return q;
+}
+
+static void flush_all(void)
+{
+	uint32_t i;
+	for (i = 0; i < NB; ++i) {
+		ent_t *e = g_b[i], *n;
+		for (; e; e = n) {
+			n = e->next;
+			free(e->key);
+			free(e->out.p);
+			free(e);
+		}
+		g_b[i] = 0;
+	}
+	g_bytes = 0, ++g_flush;
+}
+
+int mm_dpm_get(const uint32_t *key, uint32_t key_len, mm_dpm_out_t *out)
+{
+	uint64_t h = key_hash(key, key_len);
+	ent_t *e;
+	int hit = 0;
+	pthread_mutex_lock(&g_lock);
+	for (e = g_b[h & (NB - 1)]; e; e = e->next)
+		if (e->h == h && e->key_len == key_len && memcmp(e->key, key, key_len * 4) == 0) {
+			*out = e->out;
+			out->p = copy_p(e->out.p);
+			hit = 1;
+			break;
+		}
+	if (hit) ++g_hits; else ++g_miss;
+	pthread_mutex_unlock(&g_lock);
+	return hit;
+}
+
+void mm_dpm_put(const uint32_t *key, uint32_t key_len, const mm_dpm_out_t *out)
+{
+	uint64_t h = key_hash(key, key_len), sz;
+	ent_t *e = (ent_t*)malloc(sizeof(ent_t));
+	e->h = h, e->key_len = key_len;
+	e->key = (uint32_t*)malloc(key_len * 4);
+	memcpy(e->key, key, key_len * 4);
+	e->out = *out;
+	e->out.p = copy_p(out->p);
+	sz = sizeof(ent_t) + key_len * 4 + (out->p? out->p->capacity * 4 : 0);
+	pthread_mutex_lock(&g_lock);
+	if (g_bytes + sz > g_cap) flush_all();
+	e->next = g_b[h & (NB - 1)];
+	g_b[h & (NB - 1)] = e;
+	g_bytes += sz;
+	pthread_mutex_unlock(&g_lock);
+}
+
+int mm_dpm_verify(void) { return g_verify; }
+
+void mm_dpm_verified(int bad)
+{
+	if (bad) __sync_fetch_and_add(&g_vbad, 1);
+}
+
+void mm_dpm_report(void)
+{
+	if (g_b && mm_verbose >= 3)
+		fprintf(stderr, "[M::dp-memo] %lu chain alignment(s) reused, %lu computed, %lu flush(es)%s%lu\n",
+				(unsigned long)g_hits, (unsigned long)g_miss, (unsigned long)g_flush, g_verify? "; verify mismatches " : "",
+				g_verify? (unsigned long)g_vbad : 0UL);
+}
diff --git a/dpmemo.h b/dpmemo.h
new file mode 100644
index 0000000..362469a
--- /dev/null
+++ b/dpmemo.h
@@ -0,0 +1,28 @@
+/* Rustle patch (DP memo): reuse the base-level alignment of a chain whose window bases and seeds (relative to the window)
+ * equal those of a chain aligned before. Overlapping loci aligned all-vs-all present the same genomic window to the
+ * aligner many times; its result is a deterministic function of the window's bases, the seeds and the options. */
+#ifndef MM_DPMEMO_H
+#define MM_DPMEMO_H
+#include <stdint.h>
+#include "minimap.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef struct {
+	int32_t rs1, re1, qs1, qe1;   /* relative to the window starts (query on the chain's strand) */
+	int32_t mlen, blen, is_spliced;
+	int32_t split_rel, split_inv; /* split_rel < 0: no split */
+	mm_extra_t *p;                /* deep copy, or NULL */
+} mm_dpm_out_t;
+int mm_dpm_active(void);
+void mm_dpm_init(uint64_t cap_bytes);
+void mm_dpm_hash(const uint8_t *s, int64_t n, uint64_t h[2]);
+int mm_dpm_get(const uint32_t *key, uint32_t key_len, mm_dpm_out_t *out); /* 1 on a hit; out->p is a fresh copy */
+void mm_dpm_put(const uint32_t *key, uint32_t key_len, const mm_dpm_out_t *out);
+void mm_dpm_report(void);
+int mm_dpm_verify(void);              /* MM_DPM_VERIFY set: recompute every hit and compare */
+void mm_dpm_verified(int bad);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/gate.c b/gate.c
new file mode 100644
index 0000000..2e7042d
--- /dev/null
+++ b/gate.c
@@ -0,0 +1,170 @@
+/* Rustle patch (exon gate), see gate.h. The file: one interval per line, `name<TAB>start<TAB>end`, 0-based half-open, in
+ * the sequence's own coordinates; '#' lines are comments. Intervals of a sequence are sorted and merged at load. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "khash.h"
+#include "gate.h"
+
+KHASH_MAP_INIT_STR(gate, int32_t)
+
+typedef struct { int32_t n, m; uint64_t *iv; int64_t *cum; } gate_seq_t; /* iv: start<<32 | end, merged, sorted; cum: prefix bases */
+
+int mm_gate_margin = 0;
+double mm_gate_frac = 0.0;
+static khash_t(gate) *g_h = 0;
+static gate_seq_t *g_seq = 0;
+static int32_t g_n = 0, g_m = 0;
+static long g_kept = 0, g_skipped = 0;
+
+static int cmp_u64(const void *a, const void *b)
+{
+	uint64_t x = *(const uint64_t*)a, y = *(const uint64_t*)b;
+	return x < y? -1 : x > y? 1 : 0;
+}
+
+int mm_gate_load(const char *fn)
+{
+	FILE *fp;
+	char *line = 0;
+	size_t cap = 0;
+	int32_t i, j, k;
+	if ((fp = fopen(fn, "r")) == 0) return -1;
+	if (g_h == 0) g_h = kh_init(gate);
+	while (getline(&line, &cap, fp) > 0) {
+		char *p = line, *q, *name;
+		long st, en;
+		khint_t it;
+		int absent;
+		gate_seq_t *s;
+		if (line[0] == '#' || line[0] == '\n') continue;
+		if ((q = strchr(p, '\t')) == 0) continue;
+		*q = 0, name = p, p = q + 1;
+		st = strtol(p, &q, 10);
+		if (q == p || *q != '\t') continue;
+		p = q + 1;
+		en = strtol(p, &q, 10);
+		if (q == p || st < 0 || en <= st || en > 0x7fffffffL) continue;
+		it = kh_put(gate, g_h, name, &absent);
+		if (absent) {
+			kh_key(g_h, it) = strdup(name);
+			if (g_n == g_m) {
+				g_m = g_m? g_m << 1 : 1024;
+				g_seq = (gate_seq_t*)realloc(g_seq, g_m * sizeof(gate_seq_t));
+			}
+			memset(&g_seq[g_n], 0, sizeof(gate_seq_t));
+			kh_val(g_h, it) = g_n++;
+		}
+		s = &g_seq[kh_val(g_h, it)];
+		if (s->n == s->m) {
+			s->m = s->m? s->m << 1 : 4;
+			s->iv = (uint64_t*)realloc(s->iv, s->m * sizeof(uint64_t));
+		}
+		s->iv[s->n++] = (uint64_t)st << 32 | (uint64_t)en;
+	}
+	free(line);
+	fclose(fp);
+	for (i = 0; i < g_n; ++i) { /* sort, then merge overlapping or abutting intervals */
+		gate_seq_t *s = &g_seq[i];
+		qsort(s->iv, s->n, sizeof(uint64_t), cmp_u64);
+		for (j = 1, k = 0; j < s->n; ++j) {
+			uint64_t ke = (uint32_t)s->iv[k], js = s->iv[j] >> 32, je = (uint32_t)s->iv[j];
+			if (js <= ke) {
+				if (je > ke) s->iv[k] = (s->iv[k] >> 32) << 32 | je;
+			} else s->iv[++k] = s->iv[j];
+		}
+		if (s->n > 0) s->n = k + 1;
+		s->cum = (int64_t*)malloc((s->n + 1) * sizeof(int64_t));
+		s->cum[0] = 0;
+		for (j = 0; j < s->n; ++j) s->cum[j + 1] = s->cum[j] + (int64_t)((uint32_t)s->iv[j] - (s->iv[j] >> 32));
+	}
+	return g_n;
+}
+
+int mm_gate_active(void) { return g_h != 0; }
+
+static int cmp_i32(const void *a, const void *b)
+{
+	int32_t x = *(const int32_t*)a, y = *(const int32_t*)b;
+	return x < y? -1 : x > y? 1 : 0;
+}
+
+/* gated bases of `name` inside [st - margin, en + margin) and its total; NULL when the sequence is not listed */
+static const gate_seq_t *gate_window(const char *name, int32_t st, int32_t en, int64_t *in)
+{
+	khint_t it;
+	const gate_seq_t *s;
+	int64_t lo_ = (int64_t)st - mm_gate_margin, hi_ = (int64_t)en + mm_gate_margin, x;
+	int32_t i, j, lo, hi;
+	if (g_h == 0 || (it = kh_get(gate, g_h, name)) == kh_end(g_h)) return 0;
+	s = &g_seq[kh_val(g_h, it)];
+	for (lo = 0, hi = s->n; lo < hi;) { /* i = the first interval ending after lo_ */
+		int32_t mid = (lo + hi) >> 1;
+		if ((int64_t)(uint32_t)s->iv[mid] > lo_) hi = mid;
+		else lo = mid + 1;
+	}
+	i = lo;
+	for (lo = i, hi = s->n; lo < hi;) { /* j = the first interval starting at or after hi_ */
+		int32_t mid = (lo + hi) >> 1;
+		if ((int64_t)(s->iv[mid] >> 32) >= hi_) hi = mid;
+		else lo = mid + 1;
+	}
+	j = lo;
+	if (i >= j) { *in = 0; return s; }
+	x = s->cum[j] - s->cum[i];
+	if ((int64_t)(s->iv[i] >> 32) < lo_) x -= lo_ - (int64_t)(s->iv[i] >> 32);
+	if ((int64_t)(uint32_t)s->iv[j - 1] > hi_) x -= (int64_t)(uint32_t)s->iv[j - 1] - hi_;
+	*in = x;
+	return s;
+}
+
+/* Pair-level gate: a target keeps ALL its chains with this query when ONE of them could yield a record with exon-to-exon
+ * evidence: the gated bases inside the chain +- margin are >= 1 on both sides and, with --gate-frac F > 0, their minimum
+ * is >= F x the smaller of the two sequences' gated totals (the consumer's shared-exon fraction). Base-level alignment
+ * never extends a chain by more than max_gap (-g; 10 kb under -x asm*), so with --gate-margin >= max_gap no record that
+ * could pass is lost. Every other target's chains are dropped before the base-level alignment. */
+void mm_gate_filter(const mm_idx_t *mi, const char *qname, int *n_regs, mm_reg1_t *regs)
+{
+	int i, k, n_ok = 0;
+	int32_t *ok;
+	if (*n_regs <= 0) return;
+	ok = (int32_t*)malloc(*n_regs * sizeof(int32_t));
+	for (i = 0; i < *n_regs; ++i) {
+		const mm_reg1_t *r = &regs[i];
+		int64_t qx, tx, m, sm;
+		const gate_seq_t *gq = gate_window(qname, r->qs, r->qe, &qx);
+		const gate_seq_t *gt = gate_window(mi->seq[r->rid].name, r->rs, r->re, &tx);
+		if (gq == 0 || gt == 0) { ok[n_ok++] = r->rid; continue; } /* an unlisted side is never gated */
+		m = qx < tx? qx : tx;
+		sm = gq->cum[gq->n] < gt->cum[gt->n]? gq->cum[gq->n] : gt->cum[gt->n];
+		if (sm < 1) sm = 1;
+		if (m >= 1 && (mm_gate_frac <= 0.0 || (double)m / (double)sm >= mm_gate_frac)) ok[n_ok++] = r->rid;
+	}
+	qsort(ok, n_ok, sizeof(int32_t), cmp_i32);
+	for (i = k = 0; i < *n_regs; ++i) {
+		mm_reg1_t *r = &regs[i];
+		int32_t lo = 0, hi = n_ok;
+		while (lo < hi) {
+			int32_t mid = (lo + hi) >> 1;
+			if (ok[mid] < r->rid) lo = mid + 1;
+			else hi = mid;
+		}
+		if (lo < n_ok && ok[lo] == r->rid) {
+			if (k != i) regs[k] = regs[i];
+			++k;
+		} else {
+			free(r->p);
+			r->p = 0;
+		}
+	}
+	free(ok);
+	__sync_fetch_and_add(&g_kept, (long)k);
+	__sync_fetch_and_add(&g_skipped, (long)(*n_regs - k));
+	*n_regs = k;
+}
+
+void mm_gate_report(void)
+{
+	if (g_h && mm_verbose >= 3)
+		fprintf(stderr, "[M::gate] %d sequence(s) gated, margin %d, frac %g: %ld chain(s) aligned, %ld skipped\n", g_n, mm_gate_margin, mm_gate_frac, g_kept, g_skipped);
+}
