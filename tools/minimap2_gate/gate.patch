+++ b/dpmemo.c
@@ -0,0 +1,223 @@
+/* Rustle patch (DP memo), see dpmemo.h. A chained hash table under one mutex; the whole table is dropped when it exceeds
+ * its byte cap (overlapping loci are adjacent in the input, so reuse is local). Keys are compared in full. */
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+#include <pthread.h>
+#include "dpmemo.h"
+#include "kalloc.h"
+
+typedef struct ent_s {
+	uint64_t h;
+	uint32_t key_len;
+	uint32_t *key;
+	mm_dpm_out_t out;
+	struct ent_s *next;
+} ent_t;
+
+#define NB (1u<<20)
+static ent_t **g_b = 0;
+static pthread_mutex_t g_lock = PTHREAD_MUTEX_INITIALIZER;
+static uint64_t g_cap = 0, g_bytes = 0, g_hits = 0, g_miss = 0, g_flush = 0, g_vbad = 0;
+static int g_verify = 0;
+
+int mm_dpm_active(void) { return g_b != 0; }
+
+void mm_dpm_init(uint64_t cap_bytes)
+{
+	g_b = (ent_t**)calloc(NB, sizeof(ent_t*));
+	g_cap = cap_bytes;
+	g_verify = getenv("MM_DPM_VERIFY") != 0;
+}
+
+static inline uint64_t mix(uint64_t a, uint64_t w, uint64_t m, int r)
+{
+	a = (a ^ w) * m;
+	return a << r | a >> (64 - r);
+}
+
+void mm_dpm_hash(const uint8_t *s, int64_t n, uint64_t h[2])
+{
+	uint64_t a = 0x243f6a8885a308d3ULL ^ (uint64_t)n, b = 0x13198a2e03707344ULL, w;
+	int64_t i = 0;
+	for (; i + 8 <= n; i += 8) {
+		memcpy(&w, s + i, 8);
+		a = mix(a, w, 0x9e3779b97f4a7c15ULL, 31);
+		b = mix(b, w << 23 | w >> 41, 0xc2b2ae3d27d4eb4fULL, 27);
+	}
+	w = 0;
+	if (i < n) memcpy(&w, s + i, n - i);
+	a = mix(a, w ^ 0xa5, 0x9e3779b97f4a7c15ULL, 31);
+	b = mix(b, w ^ 0x5a, 0xc2b2ae3d27d4eb4fULL, 27);
+	h[0] = a ^ (b >> 29), h[1] = b ^ (a >> 31);
+}
+
+static uint64_t key_hash(const uint32_t *k, uint32_t n)
+{
+	uint64_t h[2];
+	mm_dpm_hash((const uint8_t*)k, (int64_t)n * 4, h);
+	return h[0];
+}
+
+static mm_extra_t *copy_p(const mm_extra_t *p)
+{
+	mm_extra_t *q;
+	if (p == 0) return 0;
+	q = (mm_extra_t*)malloc(p->capacity * 4);
+	memcpy(q, p, (sizeof(mm_extra_t) / 4 + p->n_cigar) * 4);
+	q->capacity = p->capacity;
+	return q;
+}
+
+static void flush_all(void)
+{
+	uint32_t i;
+	for (i = 0; i < NB; ++i) {
+		ent_t *e = g_b[i], *n;
+		for (; e; e = n) {
+			n = e->next;
+			free(e->key);
+			free(e->out.p);
+			free(e);
+		}
+		g_b[i] = 0;
+	}
+	g_bytes = 0, ++g_flush;
+}
+
+int mm_dpm_get(const uint32_t *key, uint32_t key_len, mm_dpm_out_t *out)
+{
+	uint64_t h = key_hash(key, key_len);
+	ent_t *e;
+	int hit = 0;
+	pthread_mutex_lock(&g_lock);
+	for (e = g_b[h & (NB - 1)]; e; e = e->next)
+		if (e->h == h && e->key_len == key_len && memcmp(e->key, key, key_len * 4) == 0) {
+			*out = e->out;
+			out->p = copy_p(e->out.p);
+			hit = 1;
+			break;
+		}
+	if (hit) ++g_hits; else ++g_miss;
+	pthread_mutex_unlock(&g_lock);
+	return hit;
+}
+
+void mm_dpm_put(const uint32_t *key, uint32_t key_len, const mm_dpm_out_t *out)
+{
+	uint64_t h = key_hash(key, key_len), sz;
+	ent_t *e = (ent_t*)malloc(sizeof(ent_t));
+	e->h = h, e->key_len = key_len;
+	e->key = (uint32_t*)malloc(key_len * 4);
+	memcpy(e->key, key, key_len * 4);
+	e->out = *out;
+	e->out.p = copy_p(out->p);
+	sz = sizeof(ent_t) + key_len * 4 + (out->p? out->p->capacity * 4 : 0);
+	pthread_mutex_lock(&g_lock);
+	if (g_bytes + sz > g_cap) flush_all();
+	e->next = g_b[h & (NB - 1)];
+	g_b[h & (NB - 1)] = e;
+	g_bytes += sz;
+	pthread_mutex_unlock(&g_lock);
+}
+
+int mm_dpm_verify(void) { return g_verify; }
+
+void mm_dpm_verified(int bad)
+{
+	if (bad) __sync_fetch_and_add(&g_vbad, 1);
+}
+
+/* call level (see dpmemo.h): same table design, its own lock and byte count */
+typedef struct kent_s {
+	uint64_t h;
+	uint32_t key_len;
+	uint32_t *key;
+	ksw_extz_t ez; /* ez.cigar: a malloc'ed copy of n_cigar operations */
+	struct kent_s *next;
+} kent_t;
+
+static kent_t **g_kb = 0;
+static pthread_mutex_t g_klock = PTHREAD_MUTEX_INITIALIZER;
+static uint64_t g_kbytes = 0, g_khits = 0, g_kmiss = 0, g_kflush = 0, g_kvbad = 0;
+
+static void kflush_all(void)
+{
+	uint32_t i;
+	for (i = 0; i < NB; ++i) {
+		kent_t *e = g_kb[i], *n;
+		for (; e; e = n) {
+			n = e->next;
+			free(e->key);
+			free(e->ez.cigar);
+			free(e);
+		}
+		g_kb[i] = 0;
+	}
+	g_kbytes = 0, ++g_kflush;
+}
+
+int mm_kswm_get(const uint32_t *key, uint32_t key_len, void *km, ksw_extz_t *ez)
+{
+	uint64_t h = key_hash(key, key_len);
+	kent_t *e;
+	int hit = 0;
+	pthread_mutex_lock(&g_klock);
+	if (g_kb == 0) g_kb = (kent_t**)calloc(NB, sizeof(kent_t*));
+	for (e = g_kb[h & (NB - 1)]; e; e = e->next)
+		if (e->h == h && e->key_len == key_len && memcmp(e->key, key, key_len * 4) == 0) {
+			uint32_t *cigar = ez->cigar;
+			int m_cigar = ez->m_cigar;
+			*ez = e->ez;
+			ez->cigar = cigar, ez->m_cigar = m_cigar;
+			if (ez->n_cigar > ez->m_cigar) {
+				ez->m_cigar = ez->n_cigar;
+				ez->cigar = (uint32_t*)krealloc(km, ez->cigar, ez->m_cigar * 4);
+			}
+			if (ez->n_cigar > 0) memcpy(ez->cigar, e->ez.cigar, ez->n_cigar * 4);
+			hit = 1;
+			break;
+		}
+	if (hit) ++g_khits; else ++g_kmiss;
+	pthread_mutex_unlock(&g_klock);
+	return hit;
+}
+
+void mm_kswm_put(const uint32_t *key, uint32_t key_len, const ksw_extz_t *ez)
+{
+	uint64_t h = key_hash(key, key_len), sz;
+	kent_t *e = (kent_t*)malloc(sizeof(kent_t));
+	e->h = h, e->key_len = key_len;
+	e->key = (uint32_t*)malloc(key_len * 4);
+	memcpy(e->key, key, key_len * 4);
+	e->ez = *ez;
+	e->ez.m_cigar = ez->n_cigar;
+	e->ez.cigar = ez->n_cigar > 0? (uint32_t*)malloc(ez->n_cigar * 4) : 0;
+	if (ez->n_cigar > 0) memcpy(e->ez.cigar, ez->cigar, ez->n_cigar * 4);
+	sz = sizeof(kent_t) + key_len * 4 + ez->n_cigar * 4;
+	pthread_mutex_lock(&g_klock);
+	if (g_kb == 0) g_kb = (kent_t**)calloc(NB, sizeof(kent_t*));
+	if (g_kbytes + sz > g_cap) kflush_all();
+	e->next = g_kb[h & (NB - 1)];
+	g_kb[h & (NB - 1)] = e;
+	g_kbytes += sz;
+	pthread_mutex_unlock(&g_klock);
+}
+
+void mm_kswm_verified(int bad)
+{
+	if (bad) __sync_fetch_and_add(&g_kvbad, 1);
+}
+
+void mm_dpm_report(void)
+{
+	if (g_b == 0 || mm_verbose < 3) return;
+	fprintf(stderr, "[M::dp-memo] %lu chain alignment(s) reused, %lu computed, %lu flush(es)", (unsigned long)g_hits,
+			(unsigned long)g_miss, (unsigned long)g_flush);
+	if (g_verify) fprintf(stderr, "; verify mismatches %lu", (unsigned long)g_vbad);
+	fputc('\n', stderr);
+	fprintf(stderr, "[M::dp-memo] %lu DP call(s) reused, %lu computed, %lu flush(es)", (unsigned long)g_khits,
+			(unsigned long)g_kmiss, (unsigned long)g_kflush);
+	if (g_verify) fprintf(stderr, "; verify mismatches %lu", (unsigned long)g_kvbad);
+	fputc('\n', stderr);
+}
diff --git a/dpmemo.h b/dpmemo.h
new file mode 100644
index 0000000..1cae685
--- /dev/null
+++ b/dpmemo.h
@@ -0,0 +1,34 @@
+/* Rustle patch (DP memo): reuse the base-level alignment of a chain whose window bases and seeds (relative to the window)
+ * equal those of a chain aligned before. Overlapping loci aligned all-vs-all present the same genomic window to the
+ * aligner many times; its result is a deterministic function of the window's bases, the seeds and the options. */
+#ifndef MM_DPMEMO_H
+#define MM_DPMEMO_H
+#include <stdint.h>
+#include "minimap.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef struct {
+	int32_t rs1, re1, qs1, qe1;   /* relative to the window starts (query on the chain's strand) */
+	int32_t mlen, blen, is_spliced;
+	int32_t split_rel, split_inv; /* split_rel < 0: no split */
+	mm_extra_t *p;                /* deep copy, or NULL */
+} mm_dpm_out_t;
+int mm_dpm_active(void);
+void mm_dpm_init(uint64_t cap_bytes);
+void mm_dpm_hash(const uint8_t *s, int64_t n, uint64_t h[2]);
+int mm_dpm_get(const uint32_t *key, uint32_t key_len, mm_dpm_out_t *out); /* 1 on a hit; out->p is a fresh copy */
+void mm_dpm_put(const uint32_t *key, uint32_t key_len, const mm_dpm_out_t *out);
+void mm_dpm_report(void);
+int mm_dpm_verify(void);              /* MM_DPM_VERIFY set: recompute every hit and compare */
+void mm_dpm_verified(int bad);
+/* call level: one dual-affine DP call (ksw_extd2) is a deterministic function of its arguments; key = the scalar
+ * arguments, the scoring matrix and two 128-bit hashes of the sequences */
+#include "ksw2.h"
+int mm_kswm_get(const uint32_t *key, uint32_t key_len, void *km, ksw_extz_t *ez); /* 1 on a hit; the CIGAR is copied into ez->cigar (km) */
+void mm_kswm_put(const uint32_t *key, uint32_t key_len, const ksw_extz_t *ez);
+void mm_kswm_verified(int bad);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/gate.c b/gate.c
new file mode 100644
index 0000000..2e7042d
--- /dev/null
+++ b/gate.c
@@ -0,0 +1,170 @@
+/* Rustle patch (exon gate), see gate.h. The file: one interval per line, `name<TAB>start<TAB>end`, 0-based half-open, in
+ * the sequence's own coordinates; '#' lines are comments. Intervals of a sequence are sorted and merged at load. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "khash.h"
+#include "gate.h"
+
+KHASH_MAP_INIT_STR(gate, int32_t)
+
+typedef struct { int32_t n, m; uint64_t *iv; int64_t *cum; } gate_seq_t; /* iv: start<<32 | end, merged, sorted; cum: prefix bases */
+
+int mm_gate_margin = 0;
+double mm_gate_frac = 0.0;
+static khash_t(gate) *g_h = 0;
+static gate_seq_t *g_seq = 0;
+static int32_t g_n = 0, g_m = 0;
+static long g_kept = 0, g_skipped = 0;
+
+static int cmp_u64(const void *a, const void *b)
+{
+	uint64_t x = *(const uint64_t*)a, y = *(const uint64_t*)b;
+	return x < y? -1 : x > y? 1 : 0;
+}
+
+int mm_gate_load(const char *fn)
+{
+	FILE *fp;
+	char *line = 0;
+	size_t cap = 0;
+	int32_t i, j, k;
+	if ((fp = fopen(fn, "r")) == 0) return -1;
+	if (g_h == 0) g_h = kh_init(gate);
+	while (getline(&line, &cap, fp) > 0) {
+		char *p = line, *q, *name;
+		long st, en;
+		khint_t it;
+		int absent;
+		gate_seq_t *s;
+		if (line[0] == '#' || line[0] == '\n') continue;
+		if ((q = strchr(p, '\t')) == 0) continue;
+		*q = 0, name = p, p = q + 1;
+		st = strtol(p, &q, 10);
+		if (q == p || *q != '\t') continue;
+		p = q + 1;
+		en = strtol(p, &q, 10);
+		if (q == p || st < 0 || en <= st || en > 0x7fffffffL) continue;
+		it = kh_put(gate, g_h, name, &absent);
+		if (absent) {
+			kh_key(g_h, it) = strdup(name);
+			if (g_n == g_m) {
+				g_m = g_m? g_m << 1 : 1024;
+				g_seq = (gate_seq_t*)realloc(g_seq, g_m * sizeof(gate_seq_t));
+			}
+			memset(&g_seq[g_n], 0, sizeof(gate_seq_t));
+			kh_val(g_h, it) = g_n++;
+		}
+		s = &g_seq[kh_val(g_h, it)];
+		if (s->n == s->m) {
+			s->m = s->m? s->m << 1 : 4;
+			s->iv = (uint64_t*)realloc(s->iv, s->m * sizeof(uint64_t));
+		}
+		s->iv[s->n++] = (uint64_t)st << 32 | (uint64_t)en;
+	}
+	free(line);
+	fclose(fp);
+	for (i = 0; i < g_n; ++i) { /* sort, then merge overlapping or abutting intervals */
+		gate_seq_t *s = &g_seq[i];
+		qsort(s->iv, s->n, sizeof(uint64_t), cmp_u64);
+		for (j = 1, k = 0; j < s->n; ++j) {
+			uint64_t ke = (uint32_t)s->iv[k], js = s->iv[j] >> 32, je = (uint32_t)s->iv[j];
+			if (js <= ke) {
+				if (je > ke) s->iv[k] = (s->iv[k] >> 32) << 32 | je;
+			} else s->iv[++k] = s->iv[j];
+		}
+		if (s->n > 0) s->n = k + 1;
+		s->cum = (int64_t*)malloc((s->n + 1) * sizeof(int64_t));
+		s->cum[0] = 0;
+		for (j = 0; j < s->n; ++j) s->cum[j + 1] = s->cum[j] + (int64_t)((uint32_t)s->iv[j] - (s->iv[j] >> 32));
+	}
+	return g_n;
+}
+
+int mm_gate_active(void) { return g_h != 0; }
+
+static int cmp_i32(const void *a, const void *b)
+{
+	int32_t x = *(const int32_t*)a, y = *(const int32_t*)b;
+	return x < y? -1 : x > y? 1 : 0;
+}
+
+/* gated bases of `name` inside [st - margin, en + margin) and its total; NULL when the sequence is not listed */
+static const gate_seq_t *gate_window(const char *name, int32_t st, int32_t en, int64_t *in)
+{
+	khint_t it;
+	const gate_seq_t *s;
+	int64_t lo_ = (int64_t)st - mm_gate_margin, hi_ = (int64_t)en + mm_gate_margin, x;
+	int32_t i, j, lo, hi;
+	if (g_h == 0 || (it = kh_get(gate, g_h, name)) == kh_end(g_h)) return 0;
+	s = &g_seq[kh_val(g_h, it)];
+	for (lo = 0, hi = s->n; lo < hi;) { /* i = the first interval ending after lo_ */
+		int32_t mid = (lo + hi) >> 1;
+		if ((int64_t)(uint32_t)s->iv[mid] > lo_) hi = mid;
+		else lo = mid + 1;
+	}
+	i = lo;
+	for (lo = i, hi = s->n; lo < hi;) { /* j = the first interval starting at or after hi_ */
+		int32_t mid = (lo + hi) >> 1;
+		if ((int64_t)(s->iv[mid] >> 32) >= hi_) hi = mid;
+		else lo = mid + 1;
+	}
+	j = lo;
+	if (i >= j) { *in = 0; return s; }
+	x = s->cum[j] - s->cum[i];
+	if ((int64_t)(s->iv[i] >> 32) < lo_) x -= lo_ - (int64_t)(s->iv[i] >> 32);
+	if ((int64_t)(uint32_t)s->iv[j - 1] > hi_) x -= (int64_t)(uint32_t)s->iv[j - 1] - hi_;
+	*in = x;
+	return s;
+}
+
+/* Pair-level gate: a target keeps ALL its chains with this query when ONE of them could yield a record with exon-to-exon
+ * evidence: the gated bases inside the chain +- margin are >= 1 on both sides and, with --gate-frac F > 0, their minimum
+ * is >= F x the smaller of the two sequences' gated totals (the consumer's shared-exon fraction). Base-level alignment
+ * never extends a chain by more than max_gap (-g; 10 kb under -x asm*), so with --gate-margin >= max_gap no record that
+ * could pass is lost. Every other target's chains are dropped before the base-level alignment. */
+void mm_gate_filter(const mm_idx_t *mi, const char *qname, int *n_regs, mm_reg1_t *regs)
+{
+	int i, k, n_ok = 0;
+	int32_t *ok;
+	if (*n_regs <= 0) return;
+	ok = (int32_t*)malloc(*n_regs * sizeof(int32_t));
+	for (i = 0; i < *n_regs; ++i) {
+		const mm_reg1_t *r = &regs[i];
+		int64_t qx, tx, m, sm;
+		const gate_seq_t *gq = gate_window(qname, r->qs, r->qe, &qx);
+		const gate_seq_t *gt = gate_window(mi->seq[r->rid].name, r->rs, r->re, &tx);
+		if (gq == 0 || gt == 0) { ok[n_ok++] = r->rid; continue; } /* an unlisted side is never gated */
+		m = qx < tx? qx : tx;
+		sm = gq->cum[gq->n] < gt->cum[gt->n]? gq->cum[gq->n] : gt->cum[gt->n];
+		if (sm < 1) sm = 1;
+		if (m >= 1 && (mm_gate_frac <= 0.0 || (double)m / (double)sm >= mm_gate_frac)) ok[n_ok++] = r->rid;
+	}
+	qsort(ok, n_ok, sizeof(int32_t), cmp_i32);
+	for (i = k = 0; i < *n_regs; ++i) {
+		mm_reg1_t *r = &regs[i];
+		int32_t lo = 0, hi = n_ok;
+		while (lo < hi) {
+			int32_t mid = (lo + hi) >> 1;
+			if (ok[mid] < r->rid) lo = mid + 1;
+			else hi = mid;
+		}
+		if (lo < n_ok && ok[lo] == r->rid) {
+			if (k != i) regs[k] = regs[i];
+			++k;
+		} else {
+			free(r->p);
+			r->p = 0;
+		}
+	}
+	free(ok);
+	__sync_fetch_and_add(&g_kept, (long)k);
+	__sync_fetch_and_add(&g_skipped, (long)(*n_regs - k));
+	*n_regs = k;
+}
+
+void mm_gate_report(void)
+{
+	if (g_h && mm_verbose >= 3)
+		fprintf(stderr, "[M::gate] %d sequence(s) gated, margin %d, frac %g: %ld chain(s) aligned, %ld skipped\n", g_n, mm_gate_margin, mm_gate_frac, g_kept, g_skipped);
+}
diff --git a/gate.h b/gate.h
new file mode 100644
index 0000000..72182e6
--- /dev/null
+++ b/gate.h
@@ -0,0 +1,21 @@
+/* Rustle patch (exon gate): skip the base-level alignment of every chain between a query and a target when none of
+ * their chains, padded by --gate-margin, holds listed bases on both sides (with --gate-frac F: at least F x the smaller
+ * sequence's listed total on both sides). A sequence the file does not list is never gated. Without --gate the program is
+ * the stock minimap2. */
+#ifndef MM_GATE_H
+#define MM_GATE_H
+#include <stdint.h>
+#include "minimap.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+extern int mm_gate_margin;
+extern double mm_gate_frac;
+int mm_gate_load(const char *fn);   /* sequences listed; < 0 on a read error */
+int mm_gate_active(void);
+void mm_gate_filter(const mm_idx_t *mi, const char *qname, int *n_regs, mm_reg1_t *regs);
+void mm_gate_report(void);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/ksw2_avx2_test.c b/ksw2_avx2_test.c
new file mode 100644
index 0000000..37b680e
--- /dev/null
+++ b/ksw2_avx2_test.c
@@ -0,0 +1,90 @@
+/* Differential test: ksw_extd2_avx2() must return exactly what ksw_extd2_sse41() returns.
+ * Random related sequence pairs (substitutions, indels, N, tandem copies), minimap2's scoring presets, bands from
+ * 0 to unbanded, every flag combination minimap2 uses. Usage: ksw2_avx2_test [n_cases] [seed] */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+#include "ksw2.h"
+#include "kalloc.h"
+
+void ksw_extd2_sse41(void *km, int qlen, const uint8_t *query, int tlen, const uint8_t *target, int8_t m, const int8_t *mat,
+					 int8_t q, int8_t e, int8_t q2, int8_t e2, int w, int zdrop, int end_bonus, int flag, ksw_extz_t *ez);
+void ksw_extd2_avx2(void *km, int qlen, const uint8_t *query, int tlen, const uint8_t *target, int8_t m, const int8_t *mat,
+					int8_t q, int8_t e, int8_t q2, int8_t e2, int w, int zdrop, int end_bonus, int flag, ksw_extz_t *ez);
+
+static uint64_t rng_s;
+static uint32_t rnd(void) { rng_s ^= rng_s << 13; rng_s ^= rng_s >> 7; rng_s ^= rng_s << 17; return (uint32_t)rng_s; }
+
+static int mutate(const uint8_t *a, int la, uint8_t *b, int max_lb, int rate_permille)
+{
+	int i, lb = 0;
+	for (i = 0; i < la && lb < max_lb; ++i) {
+		uint32_t x = rnd() % 1000;
+		if (x < (uint32_t)rate_permille / 3) { // substitution
+			b[lb++] = (a[i] + 1 + rnd() % 3) & 3;
+		} else if (x < (uint32_t)rate_permille * 2 / 3) { // deletion of 1..30 bases
+			i += rnd() % 30;
+		} else if (x < (uint32_t)rate_permille) { // insertion of 1..30 bases
+			int k, l = 1 + rnd() % 30;
+			for (k = 0; k < l && lb < max_lb; ++k) b[lb++] = rnd() & 3;
+			if (lb < max_lb) b[lb++] = a[i];
+		} else b[lb++] = a[i];
+	}
+	return lb;
+}
+
+int main(int argc, char *argv[])
+{
+	long n = argc > 1? atol(argv[1]) : 20000, k, n_diff = 0;
+	static const int8_t presets[][5] = { // a, b, q, e, q2, e2 packed as {b, q, e, q2, e2} with a = 1 or 2
+		{4, 6, 2, 26, 1}, {4, 4, 2, 24, 1}, {8, 12, 2, 32, 1}, {19, 39, 3, 81, 1}, {2, 4, 2, 24, 1}, {4, 24, 1, 6, 2}
+	};
+	static const int bands[] = { 0, 1, 7, 16, 33, 100, 500, 751, 1501, -1 };
+	static const int flags[] = { 0, KSW_EZ_SCORE_ONLY, KSW_EZ_RIGHT, KSW_EZ_EXTZ_ONLY, KSW_EZ_EXTZ_ONLY|KSW_EZ_RIGHT|KSW_EZ_REV_CIGAR,
+		KSW_EZ_EXTZ_ONLY|KSW_EZ_REV_CIGAR, KSW_EZ_APPROX_MAX, KSW_EZ_APPROX_MAX|KSW_EZ_APPROX_DROP, KSW_EZ_GENERIC_SC,
+		KSW_EZ_GENERIC_SC|KSW_EZ_EXTZ_ONLY|KSW_EZ_RIGHT, KSW_EZ_SCORE_ONLY|KSW_EZ_EXTZ_ONLY, KSW_EZ_APPROX_MAX|KSW_EZ_RIGHT };
+	uint8_t *a = (uint8_t*)malloc(20000), *b = (uint8_t*)malloc(40000);
+	rng_s = argc > 2? strtoull(argv[2], 0, 10) : 11;
+	if (rng_s == 0) rng_s = 11;
+	for (k = 0; k < n; ++k) {
+		ksw_extz_t e1, e2;
+		int8_t mat[25];
+		int i, j, la, lb, pr = rnd() % 6, w = bands[rnd() % 10], zdrop = (int[]){-1, 50, 100, 200, 400, 1000}[rnd() % 6];
+		int end_bonus = (int[]){-1, 0, 5, 10, 50}[rnd() % 5], flag = flags[rnd() % 12], rate = (int[]){0, 5, 20, 60, 150, 400}[rnd() % 6];
+		int8_t sa = pr == 3 || pr == 4? 2 : 1, sb = presets[pr][0];
+		// a: random, or tandem copies of a short unit; length 1..6000, mostly short
+		la = 1 + (rnd() % 8 == 0? rnd() % 6000 : rnd() % 600);
+		if (rnd() % 3 == 0) {
+			int unit = 1 + rnd() % 60;
+			for (i = 0; i < unit; ++i) a[i] = rnd() & 3;
+			for (i = unit; i < la; ++i) a[i] = rnd() % 50 == 0? rnd() & 3 : a[i - unit];
+		} else for (i = 0; i < la; ++i) a[i] = rnd() & 3;
+		lb = rnd() % 10 == 0? 1 + rnd() % 1000 : mutate(a, la, b, 40000, rate);
+		if (rnd() % 10 == 0) for (i = 0; i < lb; ++i) b[i] = rnd() & 3; // unrelated
+		if (lb == 0) b[lb++] = rnd() & 3;
+		if (rnd() % 4 == 0) for (i = 0; i < 1 + (la + lb) / 50; ++i) { // some N
+			int p = rnd() % (la + lb);
+			if (p < la) a[p] = 4; else b[p - la] = 4;
+		}
+		for (i = 0; i < 5; ++i)
+			for (j = 0; j < 5; ++j)
+				mat[i * 5 + j] = i == 4 || j == 4? (flag & KSW_EZ_GENERIC_SC? -1 : 0) : i == j? sa : -sb;
+		if (flag & KSW_EZ_GENERIC_SC) mat[1 * 5 + 2] = mat[2 * 5 + 1] = -1; // a transition-like milder mismatch
+		memset(&e1, 0, sizeof(e1)); memset(&e2, 0, sizeof(e2));
+		ksw_extd2_sse41(0, la, a, lb, b, 5, mat, presets[pr][1], presets[pr][2], presets[pr][3], presets[pr][4], w, zdrop, end_bonus, flag, &e1);
+		ksw_extd2_avx2(0, la, a, lb, b, 5, mat, presets[pr][1], presets[pr][2], presets[pr][3], presets[pr][4], w, zdrop, end_bonus, flag, &e2);
+		if (e1.max != e2.max || e1.zdropped != e2.zdropped || e1.max_q != e2.max_q || e1.max_t != e2.max_t || e1.mqe != e2.mqe
+			|| e1.mqe_t != e2.mqe_t || e1.mte != e2.mte || e1.mte_q != e2.mte_q || e1.score != e2.score || e1.reach_end != e2.reach_end
+			|| e1.n_cigar != e2.n_cigar || (e1.n_cigar && memcmp(e1.cigar, e2.cigar, e1.n_cigar * 4) != 0)) {
+			if (n_diff++ < 10)
+				fprintf(stderr, "DIFF case %ld: qlen=%d tlen=%d preset=%d w=%d zdrop=%d end_bonus=%d flag=%d | max %d/%d max_q %d/%d max_t %d/%d score %d/%d mqe %d/%d mte %d/%d n_cigar %d/%d zdropped %d/%d\n",
+						k, la, lb, pr, w, zdrop, end_bonus, flag, e1.max, e2.max, e1.max_q, e2.max_q, e1.max_t, e2.max_t,
+						e1.score, e2.score, e1.mqe, e2.mqe, e1.mte, e2.mte, e1.n_cigar, e2.n_cigar, e1.zdropped, e2.zdropped);
+		}
+		free(e1.cigar); free(e2.cigar);
+	}
+	printf("%ld cases, %ld differ\n", n, n_diff);
+	free(a); free(b);
+	return n_diff != 0;
+}
diff --git a/ksw2_dispatch.c b/ksw2_dispatch.c
index 5f5c905..5c27a6d 100644
--- a/ksw2_dispatch.c
