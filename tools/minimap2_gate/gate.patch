@@ -1,5 +1,6 @@
 #ifdef KSW_CPU_DISPATCH
 #include <stdlib.h>
+#include <stdint.h>
 #include "ksw2.h"
 
 #define SIMD_SSE     0x1
@@ -49,6 +50,16 @@ static int x86_simd(void)
 		if (cpuid[1]>>5 &1) flag |= SIMD_AVX2;
 		if (cpuid[1]>>16&1) flag |= SIMD_AVX512F;
 	}
+	if (flag & SIMD_AVX2) { // the OS must save the YMM registers; MM_KSW_NO_AVX2 forces the SSE kernels
+		int os_ymm = 0;
+		__cpuidex(cpuid, 1, 0);
+		if ((cpuid[2]>>27&1) && (cpuid[2]>>28&1)) { // OSXSAVE and AVX
+			uint32_t xcr0_lo, xcr0_hi;
+			__asm__ volatile ("xgetbv" : "=a" (xcr0_lo), "=d" (xcr0_hi) : "c" (0));
+			os_ymm = (xcr0_lo & 6) == 6;
+		}
+		if (!os_ymm || getenv("MM_KSW_NO_AVX2")) flag &= ~SIMD_AVX2;
