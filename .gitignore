# 1. Ignore everything by default
*

# 2. Allow directory structures (non-recursive allow of the directory itself)
!/.cargo/
!/analysis/
!/bench/
!/docs/
!/figures/
!/scripts/
!/src/
!/test_data/
!/tests/
!/tools/

# 3. Allow specific root files
!/.gitignore
!/Cargo.lock
!/Cargo.toml
!/README.md
!/AGENTS.md
!/AGENT_HANDOFF.md
!/analyze_missed_patterns.py
!/find_missed_loci.py
!/analyze_novel.py

# 4. Recursively allow content in these directories
!/.cargo/**
!/analysis/**
!/bench/**
!/docs/**
!/figures/**
!/scripts/**
!/src/**
!/tests/**
!/tools/**

# 5. Specific re-ignores for common junk (must come AFTER allows)
/target/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.rs.bk
.DS_Store
.claude/

# 6. Specific re-ignores for large data files and artifacts
*.bam
*.bam.bai
*.gtf
*.gff
*.fasta
*.fasta.fai
*.fa
*.fa.fai
/archive/
/chr19_stringtie_graphs/
/chr19_stringtie_supported_gfas/
/stringtie_debug/
/test_adaptive*/
/test_auto_recovery/
/test_bundle_graph/
/test_clean/
/test_compat*/
/test_final*/
/test_flow*/
/test_group_only/
/test_integrated/
/test_nofilter/
/test_revert/
/test_sensitive/
/gene_family_detector/

# 7. Test data handling (Keep synthetic family and vg_hmm fixtures, ignore large chr1 subsets)
/test_data/*
!/test_data/synthetic_family/
!/test_data/synthetic_family/**
!/test_data/vg_hmm/
!/test_data/vg_hmm/**

# 7b. Byte-parity BAM fixtures for the ported vg_family modules (e.g. o2_columns.rs).
#     These small hand-built / mined BAMs (+ .bai) are opened at test runtime, so they
#     MUST survive a fresh checkout. They override the blanket *.bam / *.bam.bai ignores
#     at lines 48-49 (last-match-wins), exactly like the test_data/ fixtures above.
!/src/rustle/vg_family/testdata/*.bam
!/src/rustle/vg_family/testdata/*.bam.bai

# 7c. Integration-test fixture for gw_family_catalog same-chromosome supplement.
!/tests/fixtures/same_chrom_supplement/*.bam
!/tests/fixtures/same_chrom_supplement/*.bam.bai
!/tests/fixtures/same_chrom_supplement/*.fa
!/tests/fixtures/same_chrom_supplement/*.fa.fai
!/tests/fixtures/from_genome/*.fa
!/tests/fixtures/from_genome/*.fa.fai

*.log

# 8. Large external dataset dumps (over GitHub's 100 MB push limit, or
#    transient external downloads). Re-fetch instructions live in the
#    corresponding README.md.
*.tsv.gz
*.gtf.gz
.superpowers/

# large local checkpoints (never commit)
bench/*.npz

# 7c. Test OUTPUTS written into the fixture dirs by the gw_family_catalog integration tests.
#     These are generated on every `cargo test` run and are not fixtures. The committed GOLDENS
#     (out.copies.tsv, out_default.*) are already tracked, and .gitignore does not affect tracked
#     files, so they keep working. Only the generated siblings are ignored.
/tests/fixtures/same_chrom_supplement/out_hom*
/tests/fixtures/same_chrom_supplement/out_famcn*
/tests/fixtures/same_chrom_supplement/out_conflict_enum*

# --- regenerable caches and debug dumps (2026-08-29) ---------------------------------------------
# Kept OUT of the repo because each is rebuilt on demand and none is an input to a result.
# ⚠ NOT ignored, deliberately: bench/compara_cache.json (reruns are deterministic ONLY given it),
# bench/family_er_pr.tsv and bench/vg_repeat_catalog.tsv (consumed by other scripts and cited in docs),
# and everything under */testdata/ and bench/fixtures/ (test fixtures — the suite fails without them).
analysis/family_graphs/data/gff_cache.rds
analysis/family_graphs/data/*_cache.rds
bench/*_debug*.jsonl
bench/st_debug*.jsonl
