# 1. Ignore everything by default
*

# 2. Allow directory structures (non-recursive allow of the directory itself)
!/.cargo/
!/analysis/
!/bench/
!/docs/
!/figures/
!/scripts/
!/src/
!/test_data/
!/tests/
!/tools/

# 3. Allow specific root files
!/.gitignore
!/Cargo.lock
!/Cargo.toml
!/README.md
!/AGENTS.md
!/AGENT_HANDOFF.md
!/analyze_missed_patterns.py
!/find_missed_loci.py
!/analyze_novel.py

# 4. Recursively allow content in these directories
!/.cargo/**
!/analysis/**
!/bench/**
!/docs/**
!/figures/**
!/scripts/**
!/src/**
!/tests/**
!/tools/**

# 5. Specific re-ignores for common junk (must come AFTER allows)
/target/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.rs.bk
.DS_Store
.claude/

# 6. Specific re-ignores for large data files and artifacts
*.bam
*.bam.bai
*.gtf
*.gff
*.fasta
*.fasta.fai
*.fa
*.fa.fai
/archive/
/chr19_stringtie_graphs/
/chr19_stringtie_supported_gfas/
/stringtie_debug/
/test_adaptive*/
/test_auto_recovery/
/test_bundle_graph/
/test_clean/
/test_compat*/
/test_final*/
/test_flow*/
/test_group_only/
/test_integrated/
/test_nofilter/
/test_revert/
/test_sensitive/
/gene_family_detector/

# 7. Test data handling (Keep synthetic family and vg_hmm fixtures, ignore large chr1 subsets)
/test_data/*
!/test_data/synthetic_family/
!/test_data/synthetic_family/**
!/test_data/vg_hmm/
!/test_data/vg_hmm/**

# 7b. Byte-parity BAM fixtures for the ported vg_family modules (e.g. o2_columns.rs).
#     These small hand-built / mined BAMs (+ .bai) are opened at test runtime, so they
#     MUST survive a fresh checkout. They override the blanket *.bam / *.bam.bai ignores
#     at lines 48-49 (last-match-wins), exactly like the test_data/ fixtures above.
!/src/rustle/vg_family/testdata/*.bam
!/src/rustle/vg_family/testdata/*.bam.bai

# 7c. Integration-test fixture for gw_family_catalog same-chromosome supplement.
!/tests/fixtures/same_chrom_supplement/*.bam
!/tests/fixtures/same_chrom_supplement/*.bam.bai
!/tests/fixtures/same_chrom_supplement/*.fa
!/tests/fixtures/same_chrom_supplement/*.fa.fai

*.log

# 8. Large external dataset dumps (over GitHub's 100 MB push limit, or
#    transient external downloads). Re-fetch instructions live in the
#    corresponding README.md.
*.tsv.gz
*.gtf.gz
.superpowers/
